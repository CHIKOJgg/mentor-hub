# ==============================================================================
# Mentor Hub — пример переменных окружения
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ТЕЛЕГРАМ-БОТ (Обязательно для приёма отчетов в Telegram)
# ------------------------------------------------------------------------------
# Получите токен у @BotFather в Telegram:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
# Юзернейм созданного бота (без символа @):
TELEGRAM_BOT_USERNAME=MentorHubBot
# Режим работы бота: long-polling (рекомендуется для Railway) или webhook
TELEGRAM_BOT_MODE=long-polling
# Включен ли бот при старте (true/false)
TELEGRAM_BOT_ENABLED=false

# ------------------------------------------------------------------------------
# 2. БАЗА ДАННЫХ POSTGRESQL
# ------------------------------------------------------------------------------
# На Railway при добавлении плагина PostgreSQL эти переменные (PGHOST, PGPORT, etc.)
# или SPRING_DATASOURCE_URL подтягиваются автоматически.
# Для локального Docker Compose; задайте уникальный пароль до запуска:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mentor_hub
DB_USER=postgres
DB_PASSWORD=
# Либо единая JDBC-строка:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mentor_hub

# ------------------------------------------------------------------------------
# 3. НЕЙРОСЕТИ ДЛЯ ТРАНСКРИБАЦИИ И ВЫЖИМКИ (AI & WHISPER)
# ------------------------------------------------------------------------------
# Внимание: если AI_API_KEY не указан или равен "mock-key", проект РАБОТАЕТ
# в полностью бесплатном автономном режиме через встроенный детерминированный парсер.
#
# ВАРИАНТ 1: GROQ CLOUD (100% БЕСПЛАТНО - И Whisper STT, и Llama 3.3 70B!)
# Регистрация: https://console.groq.com/keys
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.1-8b-instant
# AI_MODEL=llama-3.3-70b-specdec
# AI_WHISPER_MODEL=whisper-large-v3
#
# ВАРИАНТ 2: GOOGLE GEMINI (БЕСПЛАТНЫЙ TIER - 15 RPM, 1500 RPD)
# Регистрация: https://aistudio.google.com/app/apikey
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=AIzaSy...
# AI_MODEL=gemini-2.0-flash
# AI_WHISPER_MODEL=whisper-1
#
# ВАРИАНТ 3: DEEPSEEK (УЛЬТРА-ЭКОНОМИЧНЫЙ - ~$0.14 за 1 млн токенов)
# Регистрация: https://platform.deepseek.com/api_keys
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=deepseek-chat
#
# ВАРИАНТ 4: OPENROUTER (100% Бесплатный авто-роутер или бесплатные модели :free)
# Регистрация: https://openrouter.ai/keys
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=openrouter/free
# (Или конкретные :free модели: meta-llama/llama-3.3-70b-instruct:free, qwen/qwen-2.5-72b-instruct:free)
#
# БОНУСНЫЙ РЕЖИМ (Cross-Provider Fallback):
# Если основным провайдером является Groq, но вы хотите запасной OpenRouter на случай лимитов:
# OPENROUTER_API_KEY=sk-or-v1-...
#
# По умолчанию (OpenAI standard):
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_WHISPER_MODEL=whisper-1

# ------------------------------------------------------------------------------
# 4. АДМИНИСТРАТИВНЫЙ ДОСТУП
# ------------------------------------------------------------------------------
# Генерируйте разные случайные значения длиной не менее 32 символов.
# Пример: openssl rand -base64 48
ADMIN_MENTOR_TOKEN=change-me-generate-a-random-secret-at-least-32-characters
ADMIN_CURATOR_TOKEN=change-me-generate-a-different-random-secret-at-least-32-characters

# Telegram user IDs администраторов нужны для корректной маршрутизации сообщений.
ADMIN_MENTOR_TELEGRAM_USER_ID=
ADMIN_CURATOR_TELEGRAM_USER_ID=

# Бот включайте только после задания токена и обоих Telegram user IDs.

# Оставьте пустым для поставляемого same-origin frontend. Раздельный frontend требует
# отдельной настройки cookie/CORS; wildcard (*) не поддерживается.
CORS_ALLOWED_ORIGINS=

# Только для локального HTTP Compose. В production оставьте true (значение по умолчанию).
SESSION_COOKIE_SECURE=false

# Не используйте VITE_ADMIN_TOKEN: всё с префиксом VITE_ попадает в браузерную сборку.
