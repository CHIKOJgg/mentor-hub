# ==============================================================================
# Mentor Hub — Переменные окружения Telegram-бота и Сервера
# ==============================================================================

# Токен вашего бота от @BotFather в Telegram:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# Юзернейм бота (без @):
TELEGRAM_BOT_USERNAME=MentorHubBot

# Режим работы бота: long-polling (по умолчанию для локального запуска) или webhook
TELEGRAM_BOT_MODE=long-polling

# База данных PostgreSQL:
DB_HOST=localhost
DB_NAME=mentor_hub
DB_USER=postgres
DB_PASSWORD=postgres

# API-ключ для транскрибации войсов Whisper и суммаризации рефлексии (OpenAI / Gemini)
# Если ключ не указан, бот автоматически работает через детерминированный встроенный парсер
AI_API_KEY=
