# ==============================================================================
# Mentor Hub — Переменные окружения (Локальный запуск & Railway)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ТЕЛЕГРАМ-БОТ (Обязательно для приёма отчетов в Telegram)
# ------------------------------------------------------------------------------
# Получите токен у @BotFather в Telegram:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
# Юзернейм созданного бота (без символа @):
TELEGRAM_BOT_USERNAME=MentorHubBot
# Режим работы бота: long-polling (рекомендуется для Railway) или webhook
TELEGRAM_BOT_MODE=long-polling
# Включен ли бот при старте (true/false)
TELEGRAM_BOT_ENABLED=true

# ------------------------------------------------------------------------------
# 2. БАЗА ДАННЫХ POSTGRESQL
# ------------------------------------------------------------------------------
# На Railway при добавлении плагина PostgreSQL эти переменные (PGHOST, PGPORT, etc.)
# или SPRING_DATASOURCE_URL подтягиваются автоматически.
# Для локального запуска:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mentor_hub
DB_USER=postgres
DB_PASSWORD=postgres
# Либо единая JDBC-строка:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mentor_hub

# ------------------------------------------------------------------------------
# 3. НЕЙРОСЕТИ ДЛЯ ТРАНСКРИБАЦИИ И ВЫЖИМКИ (AI & WHISPER)
# ------------------------------------------------------------------------------
# Внимание: если AI_API_KEY не указан или равен "mock-key", проект РАБОТАЕТ
# в полностью бесплатном автономном режиме через встроенный детерминированный парсер.
#
# ВАРИАНТ 1: GROQ CLOUD (100% БЕСПЛАТНО - И Whisper STT, и Llama 3.3 70B!)
# Регистрация: https://console.groq.com/keys
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile
# AI_WHISPER_MODEL=whisper-large-v3
#
# ВАРИАНТ 2: GOOGLE GEMINI (БЕСПЛАТНЫЙ TIER - 15 RPM, 1500 RPD)
# Регистрация: https://aistudio.google.com/app/apikey
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=AIzaSy...
# AI_MODEL=gemini-2.0-flash
# AI_WHISPER_MODEL=whisper-1
#
# ВАРИАНТ 3: DEEPSEEK (УЛЬТРА-ЭКОНОМИЧНЫЙ - ~$0.14 за 1 млн токенов)
# Регистрация: https://platform.deepseek.com/api_keys
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=deepseek-chat
#
# ВАРИАНТ 4: OPENROUTER (Бесплатные модели :free)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# По умолчанию (OpenAI standard):
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=mock-key
AI_MODEL=gpt-4o-mini
AI_WHISPER_MODEL=whisper-1

# ------------------------------------------------------------------------------
# 4. АДМИНИСТРАТИВНЫЙ ДОСТУП
# ------------------------------------------------------------------------------
# Токены доступа ментора и куратора (по умолчанию предзаполнены в миграциях V1):
# Ксения: magic-ksenia-mentor-token-998877
# Катя:   magic-katya-curator-token-112233
